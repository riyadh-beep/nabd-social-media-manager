# Browser-safe configuration only. These values are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Backend and worker only. Never prefix these with NEXT_PUBLIC_ or VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Temporary compatibility fallback for a legacy project key:
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LEGACY_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=openai/gpt-4o-mini
# Vision-capable model for private product photo analysis.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_MODEL=z-ai/glm-5.3-flash
# OpenRouter image model for platform-specific posters.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# Optional news discovery for News / topic workspaces. Server-side only.
SERPAPI_API_KEY=REPLACE_ME
FIRECRAWL_API_KEY=fc-REPLACE_ME
BUFFER_API_KEY=REPLACE_ME
UNIPILE_API_KEY=REPLACE_ME
UNIPILE_DSN=https://YOUR_UNIPILE_DSN

# Optional until a public HTTPS endpoint is deployed.
# UNIPILE_WEBHOOK_SECRET=REPLACE_ME
# APP_ORIGIN=https://YOUR_FRONTEND
# API_PUBLIC_URL=https://YOUR_API
# CRON_SECRET=GENERATE_A_LONG_RANDOM_VALUE

APP_TIMEZONE=Asia/Riyadh
API_PORT=8787
# Hosting supplies PORT; it takes precedence over API_PORT in the API listener.
# Set NODE_ENV=production in hosted services. Leave local development unchanged.
WORKER_POLL_MS=1000

# Optional notification-only adapter. Keep unset to leave email disabled.
N8N_NOTIFICATION_WEBHOOK_URL=https://n8n.example.com/webhook/signaldesk-email-notification
N8N_NOTIFICATION_SHARED_SECRET=REPLACE_ME
