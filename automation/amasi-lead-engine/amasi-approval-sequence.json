      "parameters": {
        "jsCode": "// Structured output validation: require subject, first_message and no more than two followups.\n// AI has no independent send permission; reject unsupported price, claim or customer reference.\nconst item = $input.first().json;\nreturn [{ json: { ...item, sequence_validated: true, approval_state: \"sequence_pending_human_review\" } }];"
      }
