    {
      "id": "code-653b04fa-026d-4c34-b165-448a2b01c489",
      "name": "Validate approval command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        200
      ],
      "parameters": {
        "jsCode": "// Input validation, run tracking and a deterministic idempotency key.\nconst input = $input.first()?.json ?? {};\nconst now = new Date().toISOString();\nconst source = String(input.event_id ?? input.campaign_id ?? input.lead_id ?? input.schedule_slot ?? now.slice(0, 13));\nif (!source || !(Array.isArray(input.lead_ids) && input.lead_ids.length > 0 && Boolean(input.campaign_id))) throw new Error(\"Reject invalid input: a stable event, campaign or lead identifier is required.\");\nreturn [{ json: { ...input, trigger_type: \"webhook\", workflow_key: \"amasi.approval-sequence\", run_id: crypto.randomUUID(), idempotency_key: \"amasi.approval-sequence:\" + source, started_at: now, payload_excerpt: JSON.stringify({ event_id: input.event_id ?? null, campaign_id: input.campaign_id ?? null, lead_id: input.lead_id ?? null }).slice(0, 500), ops_runs: \"start\" } }];"
      }
    },
    {
      "id": "code-06ee7d32-c82c-4ec7-8104-b11342b1a2dd",
      "name": "Idempotency gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        200
      ],
      "parameters": {
        "jsCode": "// Atomic claim required before irreversible actions. Supabase RPC must INSERT ... ON CONFLICT on (workflow_key, idempotency_key).\n// ops_idempotency is retained for n8n operational visibility; the atomic unique constraint is the duplicate gate.\nconst item = $input.first().json;\nreturn [{ json: { ...item, duplicate_policy: \"skip completed; defer processing; retry bounded failed\", retry_after_policy: \"honor Retry-After for 429; do not retry 401/403\", ops_idempotency: \"atomic claim pending\" } }];"
      }
    },
    {
      "id": "http-576a5fe6-abea-42fa-a286-7ec6d3058627",
