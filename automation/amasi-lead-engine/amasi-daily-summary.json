    {
      "id": "code-e56ee523-aadc-4774-807c-3639ea2d9053",
      "name": "Validate reporting run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        200
      ],
      "parameters": {
        "jsCode": "// Input validation, run tracking and a deterministic idempotency key.\nconst input = $input.first()?.json ?? {};\nconst now = new Date().toISOString();\nconst source = String(input.event_id ?? input.campaign_id ?? input.lead_id ?? input.schedule_slot ?? now.slice(0, 13));\nif (!source || !(true)) throw new Error(\"Reject invalid input: a stable event, campaign or lead identifier is required.\");\nreturn [{ json: { ...input, trigger_type: \"schedule\", workflow_key: \"amasi.daily-summary\", run_id: crypto.randomUUID(), idempotency_key: \"amasi.daily-summary:\" + source, started_at: now, payload_excerpt: JSON.stringify({ event_id: input.event_id ?? null, campaign_id: input.campaign_id ?? null, lead_id: input.lead_id ?? null }).slice(0, 500), ops_runs: \"start\" } }];"
      }
    },
    {
      "id": "code-38cc985b-0077-4ac4-b24d-77420bd5d0ab",
      "name": "Idempotency gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        200
      ],
      "parameters": {
        "jsCode": "// Atomic claim required before irreversible actions. Supabase RPC must INSERT ... ON CONFLICT on (workflow_key, idempotency_key).\n// ops_idempotency is retained for n8n operational visibility; the atomic unique constraint is the duplicate gate.\nconst item = $input.first().json;\nreturn [{ json: { ...item, duplicate_policy: \"skip completed; defer processing; retry bounded failed\", retry_after_policy: \"honor Retry-After for 429; do not retry 401/403\", ops_idempotency: \"atomic claim pending\" } }];"
      }
    },
    {
      "id": "http-3d326b0b-658f-423e-9f3a-0ee0918b41e9",
