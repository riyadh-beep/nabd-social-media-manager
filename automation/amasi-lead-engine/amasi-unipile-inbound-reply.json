      "parameters": {
        "jsCode": "// Structured output validation: interested, needs_information, not_interested, contact_later, wrong_person, unsubscribe, partnership, sensitive, complaint.\n// AI drafts only. Sensitive, complaint and interested replies require_human = true.\nconst item = $input.first().json;\nreturn [{ json: { ...item, structured_output_validation: true, requires_human: true, allowed_action: \"draft_or_handover_only\" } }];"
