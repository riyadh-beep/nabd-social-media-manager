      "name": "Verify signature and validate event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        200
      ],
      "parameters": {
        "jsCode": "// Verify signature with constant-time comparison against the raw body and reject stale timestamps.\n// Reject invalid input and unsupported event variants explicitly.\nconst input = $input.first()?.json ?? {};\nif (!input.event_id) throw new Error(\"Reject invalid input: Unipile event_id required\");\nreturn [{ json: { ...input, workflow_key: \"amasi.unipile-inbound\", run_id: crypto.randomUUID(), idempotency_key: \"amasi.unipile-inbound:\" + input.event_id, verify_signature: true, signature_validation: \"required\", ops_runs: \"start\" } }];"
      }
    },
    {
      "id": "code-36b7ef68-11fc-4755-b7e0-cccc77753906",
      "name": "Idempotency gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        200
      ],
      "parameters": {
        "jsCode": "// Atomic claim required before irreversible actions. Supabase RPC must INSERT ... ON CONFLICT on (workflow_key, idempotency_key).\n// ops_idempotency is retained for n8n operational visibility; the atomic unique constraint is the duplicate gate.\nconst item = $input.first().json;\nreturn [{ json: { ...item, duplicate_policy: \"skip completed; defer processing; retry bounded failed\", retry_after_policy: \"honor Retry-After for 429; do not retry 401/403\", ops_idempotency: \"atomic claim pending\" } }];"
      }
    },
    {
      "id": "http-a52b5aef-6e69-41d0-b625-f7d35f61ec06",
